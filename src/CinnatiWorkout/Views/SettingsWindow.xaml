<Window x:Class="CinnatiWorkout.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Width="640" SizeToContent="Height"
        Icon="{DynamicResource AppIconBitmap}" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Pallino colore: Tag="selected" mostra l'anello di selezione. -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Visibility="Hidden" />
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource LineBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource AppLogo}" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="Impostazioni" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Cinnati Workout" Style="{StaticResource Muted}" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,20,0,18" Foreground="{StaticResource MutedBrush}"
                   Text="Scegli la cartella principale su Google Drive in cui si trovano schede e pliche." />

        <TextBlock Text="CARTELLA PRINCIPALE" Style="{StaticResource FieldLabel}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Sfoglia…" Tag="&#xE838;" Click="Browse_Click" Margin="8,0,0,0" />
            <TextBox x:Name="RootBox" />
        </DockPanel>
        <Button HorizontalAlignment="Left" Style="{StaticResource AccentGhostButton}" Tag="&#xE721;" Content="Rileva Google Drive automaticamente"
                Click="Detect_Click" Margin="-8,8,0,0" />

        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock TextWrapping="Wrap" Width="520" Style="{StaticResource Muted}"
                           Text="Serve Google Drive per desktop: la cartella di Drive (es. G:\Il mio Drive) viene sincronizzata automaticamente con il cloud." />
            </StackPanel>
        </Border>

        <!-- Colore principale -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,20,0,0">
            <StackPanel>
                <TextBlock Text="COLORE PRINCIPALE" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="Usato per pulsanti, evidenziazioni e risultati. L'anteprima è immediata." Style="{StaticResource Muted}" Margin="0,0,0,12" />
                <WrapPanel x:Name="SwatchPanel" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Personalizzato" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                    <Border x:Name="CustomPreview" Width="30" Height="30" CornerRadius="6" Margin="0,0,8,0"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                    <TextBox x:Name="HexBox" Width="110" MaxLength="7" FontFamily="Consolas" TextChanged="HexBox_TextChanged" />
                    <TextBlock x:Name="HexError" Text="Formato: #RRGGBB" Foreground="{StaticResource DangerBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" />
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE777;" Content="Predefinito" Margin="12,0,0,0" Click="ResetColor_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Logo in stampa -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,20,0,0">
            <StackPanel>
                <TextBlock Text="LOGO NELLE SCHEDE" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="Stampato in alto a sinistra sulle schede allenamento (non sulle pliche)." Style="{StaticResource Muted}" Margin="0,0,0,12" />
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="150" Height="90" CornerRadius="8" Background="White"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8">
                        <Grid>
                            <Image x:Name="LogoPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="LogoEmpty" Text="Nessun logo" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button HorizontalAlignment="Left" Content="Scegli immagine…" Tag="&#xEB9F;" Click="ChooseLogo_Click" />
                        <Button x:Name="RemoveLogoButton" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Tag="&#xE74D;"
                                Content="Rimuovi logo" Margin="-8,8,0,0" Click="RemoveLogo_Click" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annulla" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="Salva" IsDefault="True" MinWidth="100" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
