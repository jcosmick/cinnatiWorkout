<UserControl x:Class="CinnatiWorkout.Views.SkinfoldEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,20,28,0">
        <!-- Atleta -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ATLETA" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource InlineTitleBox}" FontSize="20" MinWidth="280" HorizontalAlignment="Left"
                         Text="{Binding Athlete, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <!-- Modello uomo / donna: cambiarlo riscrive il file sull'altro modello -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,2">
                <TextBlock Text="MODELLO" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="MaleOption" Style="{StaticResource Segment}" GroupName="Gender" Content="Uomo"
                                     PreviewMouseLeftButtonDown="GenderOption_PreviewMouseDown" PreviewKeyDown="GenderOption_PreviewKeyDown" />
                        <RadioButton x:Name="FemaleOption" Style="{StaticResource Segment}" GroupName="Gender" Content="Donna"
                                     PreviewMouseLeftButtonDown="GenderOption_PreviewMouseDown" PreviewKeyDown="GenderOption_PreviewKeyDown" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- File con immagini rovinate dalle versioni precedenti -->
        <Border x:Name="RestoreBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource WarningSoftBrush}"
                CornerRadius="10" Padding="16,12" Margin="0,4,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Tag="&#xE777;" Content="Ripristina immagini"
                        VerticalAlignment="Center" Click="RestoreLayout_Click" />
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource WarningTextBrush}" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Le immagini di questo file sono state alterate da una versione precedente dell'app"
                               FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Il ripristino rimette logo e immagini del modello originale e conserva tutti i dati inseriti."
                               Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl>
            <TabItem Header="Rilevazioni">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Elenco rilevazioni -->
                    <ListBox x:Name="MeasureList" Style="{StaticResource CardList}" ItemsSource="{Binding Measurements}" SelectedIndex="0"
                             Margin="0,0,0,20">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DateLabel" Text="{Binding DateText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border x:Name="FatPill" Grid.Column="1" Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding FatPercent, StringFormat='{}{0:N1} %'}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding FatPercent}" Value="{x:Null}">
                                        <Setter TargetName="FatPill" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter TargetName="DateLabel" Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                        <Setter TargetName="DateLabel" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Dettaglio -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  DataContext="{Binding SelectedItem, ElementName=MeasureList}">
                        <StackPanel Margin="20,0,4,28">
                            <!-- Dati -->
                            <Border Style="{StaticResource Card}" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" />
                                        <TextBlock Text="Dati generali dell'atleta al momento della misurazione" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="DATA" Style="{StaticResource FieldLabel}" />
                                            <DatePicker SelectedDate="{Binding Date}" Width="150" Height="36" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="ETÀ" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource NumberBox}" Width="70" Height="36" Padding="8,0" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="PESO (KG)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource NumberBox}" Width="90" Height="36" Padding="8,0" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Pliche + risultati -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <DockPanel Margin="20,16,20,12">
                                            <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <TextBlock Text="Pliche" Style="{StaticResource CardTitle}" />
                                        </DockPanel>
                                        <DataGrid ItemsSource="{Binding Folds}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="PLICA" Binding="{Binding Name}" IsReadOnly="True" Width="2*"
                                                                    ElementStyle="{StaticResource CellTextStrong}" />
                                                <DataGridTextColumn Header="1ª" Binding="{Binding M1, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                                    HeaderStyle="{StaticResource CenteredHeader}"
                                                                    ElementStyle="{StaticResource CellTextCenter}" EditingElementStyle="{StaticResource CellEditorCenter}" />
                                                <DataGridTextColumn Header="2ª" Binding="{Binding M2, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                                    HeaderStyle="{StaticResource CenteredHeader}"
                                                                    ElementStyle="{StaticResource CellTextCenter}" EditingElementStyle="{StaticResource CellEditorCenter}" />
                                                <DataGridTextColumn Header="3ª" Binding="{Binding M3, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                                    HeaderStyle="{StaticResource CenteredHeader}"
                                                                    ElementStyle="{StaticResource CellTextCenter}" EditingElementStyle="{StaticResource CellEditorCenter}" />
                                                <DataGridTextColumn Header="MEDIA" Binding="{Binding Average, StringFormat=N2}" IsReadOnly="True" Width="*"
                                                                    HeaderStyle="{StaticResource CenteredHeader}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="0,0,10,10" Padding="20,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2, TargetNullValue=–}"
                                                           FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="Totale pliche" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource StatTile}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}">
                                        <StackPanel>
                                            <TextBlock Text="% Massa grassa" Foreground="{DynamicResource AccentForegroundBrush}" Opacity="0.85" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="32"
                                                       Text="{Binding FatPercent, StringFormat='{}{0:N2} %', TargetNullValue=–}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTile}">
                                        <StackPanel>
                                            <TextBlock Text="Massa grassa" Style="{StaticResource Muted}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding FatKg, StringFormat='{}{0:N2} kg', TargetNullValue=–}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTile}">
                                        <StackPanel>
                                            <TextBlock Text="Massa magra" Style="{StaticResource Muted}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding LeanKg, StringFormat='{}{0:N2} kg', TargetNullValue=–}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="4,0"
                                               Text="{Binding DataContext.Layout.FormulaDescription, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Circonferenze -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock DockPanel.Dock="Right" Text="cm" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Circonferenze" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Circumferences}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,12,12">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" Margin="0,0,0,5" />
                                                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Note -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Note" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Riepilogo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top" Margin="0,0,0,28">
                        <StackPanel>
                            <StackPanel Margin="20,16,20,12">
                                <TextBlock Text="Andamento rilevazioni" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Valori calcolati da ogni rilevazione" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Measurements}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RILEVAZIONE" Binding="{Binding DisplayName}" Width="1.4*" ElementStyle="{StaticResource CellTextStrong}" />
                                    <DataGridTextColumn Header="DATA" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="PESO KG" Binding="{Binding WeightKg, StringFormat=N1}" Width="*" HeaderStyle="{StaticResource CenteredHeader}" ElementStyle="{StaticResource CellTextCenter}" />
                                    <DataGridTextColumn Header="TOT. PLICHE" Binding="{Binding Total, StringFormat=N2}" Width="*" HeaderStyle="{StaticResource CenteredHeader}" ElementStyle="{StaticResource CellTextCenter}" />
                                    <DataGridTextColumn Header="% MASSA GRASSA" Binding="{Binding FatPercent, StringFormat=N2}" Width="1.2*" HeaderStyle="{StaticResource CenteredHeader}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="MASSA GRASSA KG" Binding="{Binding FatKg, StringFormat=N2}" Width="1.2*" HeaderStyle="{StaticResource CenteredHeader}" ElementStyle="{StaticResource CellTextCenter}" />
                                    <DataGridTextColumn Header="MASSA MAGRA KG" Binding="{Binding LeanKg, StringFormat=N2}" Width="1.2*" HeaderStyle="{StaticResource CenteredHeader}" ElementStyle="{StaticResource CellTextCenter}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
