<UserControl x:Class="CinnatiWorkout.Views.WorkoutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Azioni di riga: visibili al passaggio del mouse o sulla riga selezionata. -->
        <DataTemplate x:Key="RowActions">
            <StackPanel x:Name="Panel" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0">
                <Button Style="{StaticResource IconButton}" Tag="&#xE70E;" ToolTip="Sposta su" Width="26" Height="26" Click="MoveUp_Click" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE70D;" ToolTip="Sposta giù" Width="26" Height="26" Click="MoveDown_Click" />
                <Button Style="{StaticResource DangerIconButton}" Tag="&#xE74D;" ToolTip="Elimina esercizio" Width="26" Height="26" Click="DeleteRow_Click" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter TargetName="Panel" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter TargetName="Panel" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Nota generale e riepilogo -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="NOTA GENERALE" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,5,0,0">
                            <TextBox x:Name="NoteBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="40" VerticalContentAlignment="Top" />
                            <!-- Suggerimento visibile solo con nota vuota -->
                            <TextBlock Text="Es. All'inizio sempre: foam roller, mobilità anche, gambe, spalle…" IsHitTestVisible="False"
                                       Margin="11,9,0,0" Foreground="{StaticResource SubtleBrush}" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NoteBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,20,0,0">
                        <Border Style="{StaticResource Pill}" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF0E3;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0" />
                                <TextBlock x:Name="BlockCountText" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}" Padding="12,6" Background="{StaticResource HoverBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                                <TextBlock x:Name="ExerciseCountText" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="BlocksPanel" />

            <Button x:Name="AddBlockButton" Tag="&#xE710;" Content="Aggiungi scheda" HorizontalAlignment="Left" Padding="16,9"
                    Click="AddBlock_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
